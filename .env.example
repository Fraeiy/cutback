# AssemblyAI API key. Required for real transcription and the live voice agent.
# Create one at https://www.assemblyai.com/dashboard/api-keys
# The server keeps this key. The browser only receives a one-time voice token
# from GET https://agents.assemblyai.com/v1/token (minted here).
# Pre-recorded transcription uses https://api.assemblyai.com/v2/upload and /v2/transcript.
# The voice agent uses AssemblyAI's managed model through an inline session.update.
# An OpenAI or OpenRouter key is not used.
ASSEMBLYAI_API_KEY=

# Optional. When set, every /api request must send header x-cutback-token: <value>.
# Set this before putting the server on a public URL. Anyone who can open the app
# can otherwise start voice sessions billed to your AssemblyAI key.
CUTBACK_ACCESS_TOKEN=

# Uploads, project JSON, and rendered MP4s. Defaults to ./data under the server.
CUTBACK_DATA_DIR=./data

# API port. In production the same process serves the built web app.
PORT=8791

# Comma-separated browser origins allowed to call the API during development.
CUTBACK_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Optional absolute paths. Defaults to ffmpeg and ffprobe on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
